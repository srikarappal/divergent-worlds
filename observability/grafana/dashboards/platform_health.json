{
  "uid": "rlworld-platform-health",
  "title": "rlworld platform health",
  "description": "Platform health for operators (DESIGN.md 6.15); run level views live in the web console.",
  "tags": [
    "rlworld"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lease latency p50 and p99 per pool",
      "description": "Time to place, admit and start a lease group.",
      "datasource": {
        "type": "prometheus",
        "uid": "rlworld-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rlworld-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, pool) (rate(rlworld_fleet_lease_seconds_bucket[5m])))",
          "legendFormat": "p50 {{pool}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "rlworld-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, pool) (rate(rlworld_fleet_lease_seconds_bucket[5m])))",
          "legendFormat": "p99 {{pool}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Restore failures per pool",
      "description": "Envs whose snapshot restore or start failed, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "rlworld-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rlworld-prometheus"
          },
          "expr": "sum by (pool) (rate(rlworld_fleet_restore_failures_total[5m]))",
          "legendFormat": "{{pool}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Env error rate per image",
      "description": "Share of scored episodes that ended in an env error.",
      "datasource": {
        "type": "prometheus",
        "uid": "rlworld-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rlworld-prometheus"
          },
          "expr": "sum by (image) (rate(rlworld_episodes_total{termination=\"env_error\"}[15m])) / sum by (image) (rate(rlworld_episodes_total[15m]))",
          "legendFormat": "{{image}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Env error rate per app",
      "description": "Share of scored episodes whose world held the app that ended in an env error.",
      "datasource": {
        "type": "prometheus",
