{
  "listen": "127.0.0.1:8700",
  "driver": "docker",
  "host": {"id": "laptop", "pool": "linux", "cpu_millicores": 8000, "memory_mib": 3584, "gpus": 0, "licenses": []},
  "capacity": 2,
  "reserved": {"interactive": 1},
  "lease_ttl_seconds": 300,
  "state_dir": "/tmp/rlworld/fleetd",
  "object_store_dir": "../../data/trajectories",
  "guest_timeout_seconds": 30,
  "docker": {
    "security_options": ["seccomp=unconfined"],
    "shm_size_mib": 1024,
    "ready_timeout_seconds": 120,
    "snapshot_repository": "rlworld-snapshot"
  }
}
